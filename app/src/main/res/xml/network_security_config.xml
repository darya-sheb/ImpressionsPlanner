<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- GigaChat API (НУЦ Минцифры): разрешаем системные и пользовательские сертификаты -->
    <domain-config>
        <domain includeSubdomains="true">ngw.devices.sberbank.ru</domain>
        <domain includeSubdomains="true">gigachat.devices.sberbank.ru</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
